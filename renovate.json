{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "testSnapshots/**",
    "repository/**"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.charleskorn.kaml:kaml",
        "org.jetbrains.kotlinx:kotlinx-datetime"
      ],
      "enabled": false
    }
  ]
}
