

import com.intellij.DynamicBundle
{{#unless isKotlinEnabled}}
import org.jetbrains.annotations.Nls
{{/unless}}
import org.jetbrains.annotations.PropertyKey
import java.util.function.Supplier

private const val BUNDLE = "messages.MyMessageBundle"

internal object MyMessageBundle {
    private val instance = DynamicBundle(MyMessageBundle::class.java, BUNDLE)

    @JvmStatic
    fun message(key: @PropertyKey(resourceBundle = BUNDLE) String, vararg params: Any?): {{#if isKotlinEnabled}}String{{else}}@Nls String{{/if}} {
        return instance.getMessage(key, *params)
    }

    @JvmStatic
    fun lazyMessage(@PropertyKey(resourceBundle = BUNDLE) key: String, vararg params: Any?): Supplier<{{#if isKotlinEnabled}}String{{else}}@Nls String{{/if}}> {
        return instance.getLazyMessage(key, *params)
    }
}
