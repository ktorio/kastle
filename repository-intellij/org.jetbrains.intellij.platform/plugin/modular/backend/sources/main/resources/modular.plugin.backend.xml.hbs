<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="{{pluginModuleName}}.shared"/>
        {{#if _slots.backendModuleDescriptorDependencies}}

        {{slots backendModuleDescriptorDependencies}}
        {{/if}}
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        {{#if addSampleCode}}
        <platform.rpc.backend.remoteApiProvider implementation="{{_project.group}}.BackendRpcApiProvider"/>{{/if}}
    </extensions>
</idea-plugin>
