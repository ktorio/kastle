<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="{{pluginModuleName}}.shared"/>
        {{#if _slots.frontendModuleDescriptorDependencies}}

        {{slots frontendModuleDescriptorDependencies}}
        {{/if}}
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- If the plugin is published on JetBrains Marketplace, errors reported by users are available on the plugin page.
             See https://plugins.jetbrains.com/docs/marketplace/error-handler.html#developers-side for details. -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        {{#if addSampleCode}}
        <toolWindow
                id="ModularPlugin"
                factoryClass="{{_project.group}}.toolWindow.ModularPluginToolWindowFactory"
                icon="{{_project.group}}.ModularPluginIcons.ToolWindow"/>{{/if}}
    </extensions>
</idea-plugin>
