<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="intellij.platform.compose"/>
        <module name="modular.plugin.shared"/>

        {{slots frontendModuleDescriptorDependencies}}
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        {{#if addSampleCode}}
        <toolWindow
                id="ModularPlugin"
                factoryClass="{{_project.group}}.toolWindow.ModularPluginToolWindowFactory"
                icon="{{_project.group}}.ModularPluginIcons.ToolWindow"/>{{/if}}
    </extensions>
</idea-plugin>
