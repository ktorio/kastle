<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="intellij.platform.compose"/>
        <module name="modular.plugin.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="ModularPlugin"
                factoryClass="com.acme.toolWindow.ModularPluginToolWindowFactory"
                icon="com.acme.ModularPluginIcons.ToolWindow"/>
    </extensions>
</idea-plugin>
