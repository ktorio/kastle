<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="intellij.platform.compose"/>
        <module name="plugin.with.samples.all.packs.enabled.shared"/>

        <plugin id="com.intellij.kotlin.frontend"/>
        <module name="intellij.javascript.frontend"/>
        <module name="intellij.markdown.frontend"/>
        <module name="intellij.database.sql.frontend.core"/>
        <module name="intellij.database.sql.frontend.impl"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="ModularPlugin"
                factoryClass="com.acme.toolWindow.ModularPluginToolWindowFactory"
                icon="com.acme.ModularPluginIcons.ToolWindow"/>
    </extensions>
</idea-plugin>
